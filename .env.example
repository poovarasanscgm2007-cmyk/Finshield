# ==============================================================================
# FINSHIELD AI: Environment Configuration Template (.env.example)
# Copy this file to `backend/.env` for local execution:
#   cp .env.example backend/.env
# ==============================================================================

# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
# For in-memory prototyping mode, FINSHIELD automatically falls back if PostgreSQL is unreachable.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finshield

# Authentication (HMAC SHA-256 JWT Secret)
# In production, replace with a secure randomly generated string (>= 32 chars)
JWT_SECRET=finshield_sample_secret_key_change_in_production_32chars

# AI / LLM Configuration (Google Gemini API)
# Optional: If not provided or invalid, the app transparently uses the deterministic fallback engine.
LLM_API_KEY=sample_gemini_api_key_placeholder

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173
