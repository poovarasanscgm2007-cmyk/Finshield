# ==============================================================================
# FINSHIELD AI: Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Environment variables & secrets (NEVER commit actual credentials)
.env
.env.*
!.env.example
!**/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/

# Vite / bundler temporary caches
.vite/
**/.vite/
.turbo/
.cache/
.parcel-cache/

# Coverage and test artifacts
coverage/
**/coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime user uploads (preserve directory with .gitkeep)
uploads/invoices/*
!uploads/invoices/.gitkeep
temp/
tmp/

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor / IDE local files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
